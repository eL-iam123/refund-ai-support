2-2-2-1\" data-name=\"customer claim boundary cell\">\n                        <span class=\"boundary-label\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"customer claim label\">\n                            Customer claim\n                        </span>\n                        <span class=\"boundary-copy\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"customer claim quote text\">\n                            “It is different from what was described. It is blue; I ordered the red one.”\n                        </span>\n                    </div>\n                    <div class=\"boundary-cell\" data-kid=\"1-2-2-2-2-2\" data-name=\"assistant boundary cell\">\n                        <span class=\"boundary-label\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"assistant label\">\n                            Assistant\n                        </span>\n                        <span class=\"boundary-copy\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"assistant behavior text\">\n                            <strong data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"assistant action summary\">\n                                Asked for clarification.\n                            </strong>\n                            <br data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"line break\"/>\n                            <em data-kid=\"1-2-2-2-2-2-2-3\" data-name=\"assistant caveat note\">\n                                No grounded refund proposal yet.\n                            </em>\n                        </span>\n                    </div>\n                    <div class=\"boundary-cell\" data-kid=\"1-2-2-2-2-3\" data-name=\"written policy result cell\">\n                        <span class=\"boundary-label\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"policy result label\">\n                            Written policy result\n                        </span>\n                        <span class=\"boundary-result\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"policy result status row\">\n                            <span class=\"status\" data-kid=\"1-2-2-2-2-3-2-1\" data-name=\"escalated status pill\">\n                                <span class=\"status-dot\" data-kid=\"1-2-2-2-2-3-2-1-1\" data-name=\"status dot\">\n                                </span>\n                                Escalated\n                            </span>\n                        </span>\n                        <span class=\"amount-note\" data-kid=\"1-2-2-2-2-3-3\" data-name=\"payable amount note\">\n                            $0.00 proposed · not payable\n                        </span>\n                    </div>\n                    <div class=\"boundary-cell\" data-kid=\"1-2-2-2-2-4\" data-name=\"next authority cell\">\n                        <span class=\"boundary-label\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"next authority label\">\n                            Next authority · staff\n                        </span>\n                        <div class=\"boundary-action\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"next authority action row\">\n                            <span class=\"handoff-copy\" data-kid=\"1-2-2-2-2-4-2-1\" data-name=\"handoff explanation text\">\n                                A person must review before this can move forward.\n                            </span>\n                            <button class=\"primary\" data-kid=\"1-2-2-2-2-4-2-2\" data-name=\"take over primary button\" type=\"button\">\n                                <i class=\"icon icon-headset\" data-kid=\"1-2-2-2-2-4-2-2-1\" data-name=\"headset icon\">\n                                </i>\n                                Take over\n                            </button>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"case-body\" data-kid=\"1-2-2-2-3\" data-name=\"case body grid (conversation + case file)\">\n                    <section aria-label=\"Conversation thread\" class=\"conversation\" data-kid=\"1-2-2-2-3-1\" data-name=\"conversation section\">\n                        <div class=\"section-head\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"conversation section header\">\n                            <h3 data-kid=\"1-2-2-2-3-1-1-1\" data-name=\"conversation section title\">\n                                Conversation\n                            </h3>\n                            <span data-kid=\"1-2-2-2-3-1-1-2\" data-name=\"conversation thread label\">\n                                Whole order thread\n                            </span>\n                        </div>\n                        <div class=\"thread\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"messages thread container\">\n                            <div class=\"message customer\" data-kid=\"1-2-2-2-3-1-2-1\" data-name=\"customer message bubble\">\n                                <div class=\"message-head\" data-kid=\"1-2-2-2-3-1-2-1-1\" data-name=\"message sender header\">\n                                    <i class=\"icon icon-user-round\" data-kid=\"1-2-2-2-3-1-2-1-1-1\" data-name=\"customer user icon\">\n                                    </i>\n                                    Customer\n                                </div>\n                                <p data-kid=\"1-2-2-2-3-1-2-1-2\" data-name=\"customer message text\">\n                                    “I have a problem with my order.”\n                                </p>\n                            </div>\n                            <div class=\"message assistant\" data-kid=\"1-2-2-2-3-1-2-2\" data-name=\"assistant message bubble\">\n                                <span class=\"turn-tag\" data-kid=\"1-2-2-2-3-1-2-2-1\" data-name=\"turn purpose tag\">\n                                    Assistant asked · not a decision\n                                </span>\n                                <div class=\"message-head\" data-kid=\"1-2-2-2-3-1-2-2-2\" data-name=\"message sender header\">\n                                    <i class=\"icon icon-bot\" data-kid=\"1-2-2-2-3-1-2-2-2-1\" data-name=\"bot icon\">\n                                    </i>\n                                    Assistant\n                                </div>\n                                <p data-kid=\"1-2-2-2-3-1-2-2-3\" data-name=\"assistant message text\">\n                                    Just so I check this properly — what has gone wrong with it? For example something broken, something different from what you ordered, a delivery problem, or a charge you did not expect.\n                                </p>\n                            </div>\n                            <div class=\"message customer\" data-kid=\"1-2-2-2-3-1-2-3\" data-name=\"customer message bubble (repeat)\">\n                                <div class=\"message-head\" data-kid=\"1-2-2-2-3-1-2-3-1\" data-name=\"message sender header\">\n                                    <i class=\"icon icon-user-round\" data-kid=\"1-2-2-2-3-1-2-3-1-1\" data-name=\"customer user icon\">\n                                    </i>\n                                    Customer\n                                </div>\n                                <p data-kid=\"1-2-2-2-3-1-2-3-2\" data-name=\"customer message text\">\n                                    “I have a problem with my order.”\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"thread-lock\" data-kid=\"1-2-2-2-3-1-3\" data-name=\"thread lock notice\">\n                            <i class=\"icon icon-lock-keyhole\" data-kid=\"1-2-2-2-3-1-3-1\" data-name=\"lock icon\">\n                            </i>\n                            <span data-kid=\"1-2-2-2-3-1-3-2\" data-name=\"lock notice text\">\n                                <strong data-kid=\"1-2-2-2-3-1-3-2-1\" data-name=\"lock call-to-takeover strong\">\n                                    Take over to reply.\n                                </strong>\n                                The customer has not yet been handed to a person.\n                            </span>\n                        </div>\n                        <form class=\"composer\" data-kid=\"1-2-2-2-3-1-4\" data-name=\"reply composer form\">\n                            <input aria-label=\"Reply to the customer\" data-kid=\"1-2-2-2-3-1-4-1\" data-name=\"reply input field (disabled)\" disabled=\"\" placeholder=\"Reply is available after you take over\" type=\"text\"/>\n                            <button data-kid=\"1-2-2-2-3-1-4-2\" data-name=\"send reply button (disabled)\" disabled=\"\" type=\"button\">\n                                Send reply\n                            </button>\n                        </form>\n                    </section>\n                    <aside aria-label=\"Case evidence and policy trail\" class=\"case-file\" data-kid=\"1-2-2-2-3-2\" data-name=\"case file sidebar\">\n                        <div class=\"file-block\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"case file block\">\n                            <div class=\"section-head\" data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"case file section header\">\n                                <h3 data-kid=\"1-2-2-2-3-2-1-1-1\" data-name=\"case file title\">\n                                    Case file\n                                </h3>\n                                <span data-kid=\"1-2-2-2-3-2-1-1-2\" data-name=\"case file item count\">\n                                    1 item\n                                </span>\n                            </div>\n                            <p class=\"file-label\" data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"customer's words label\">\n                                Customer’s words\n                            </p>\n                            <blockquote class=\"quote\" data-kid=\"1-2-2-2-3-2-1-3\" data-name=\"customer quote block\">\n                                “It is different from what was described, it is blue I ordered for the red one.”\n                            </blockquote>\n                        </div>\n                        <div class=\"file-block\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"evidence confirmed block\">\n                            <p class=\"file-label\" data-kid=\"1-2-2-2-3-2-2-1\" data-name=\"evidence label\">\n                                Evidence confirmed\n                            </p>\n                            <p class=\"boundary-copy\" data-kid=\"1-2-2-2-3-2-2-2\" data-name=\"evidence description text\">\n                                Nothing was verified against the customer’s own words.\n                            </p>\n                        </div>\n                        <div class=\"file-block\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"policy result block\">\n                            <p class=\"file-label\" data-kid=\"1-2-2-2-3-2-3-1\" data-name=\"policy result label\">\n                                Policy result\n                            </p>\n                            <div class=\"decision-note\" data-kid=\"1-2-2-2-3-2-3-2\" data-name=\"decision note callout\">\n                                <strong data-kid=\"1-2-2-2-3-2-3-2-1\" data-name=\"decision note heading\">\n                                    No rule reached a conclusion.\n                                </strong>\n                                The request was escalated for human review. The written policy—not the assistant—determines any refund outcome.\n                            </div>\n                            <div class=\"trail-summary\" data-kid=\"1-2-2-2-3-2-3-3\" data-name=\"trail summary row\">\n                                <strong data-kid=\"1-2-2-2-3-2-3-3-1\" data-name=\"rules that ran label\">\n                                    Rules that ran\n                                </strong>\n                                <span data-kid=\"1-2-2-2-3-2-3-3-2\" data-name=\"rules count and order text\">\n                                    18 · evaluation order\n                                </span>\n                            </div>\n                            <a class=\"trail-link\" data-kid=\"1-2-2-2-3-2-3-4\" data-name=\"open policy trace link\" href=\"#\">\n                                <i class=\"icon icon-file-text\" data-kid=\"1-2-2-2-3-2-3-4-1\" data-name=\"document icon\">\n                                </i>\n                                Open full policy trace in request history\n                            </a>\n                        </div>\n                    </aside>\n                </div>\n                <footer class=\"secondary-actions\" data-kid=\"1-2-2-2-4\" data-name=\"secondary actions footer\">\n                    <span data-kid=\"1-2-2-2-4-1\" data-name=\"close ticket guidance text\">\n                        Close only after the customer’s issue is resolved.\n                    </span>\n                    <a data-kid=\"1-2-2-2-4-2\" data-name=\"close ticket action link\" href=\"#\">\n                        Close ticket\n                    </a>\n                </footer>\n            </article>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-07T18:49:02.925861+00:00",
      "modified": "2026-10-07T18:56:59.427802+00:00",
      "id": "var_607a9c3c2f74",
      "contentHeight": 1039
    },
    "var_d7f35ea86b07": {
      "type": "variant",
      "label": "Readable Case Record — Shopper Help",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@400;500;600;700&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n.app {\n  --ink: #1c1917;\n  --ink-soft: #57534e;\n  --ink-faint: #78716c;\n  --page: #f7f5f2;\n  --surface: #fffdfa;\n  --surface-soft: #f3f1ed;\n  --line: #e7e2da;\n  --line-strong: #d6cec3;\n  --brand: #e85d04;\n  --brand-deep: #c94800;\n  --brand-soft: #fff0e5;\n  --ok: #087443;\n  --ok-soft: #eaf8f0;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  color: var(--ink);\n  background: var(--page);\n  font-family: 'Fira Sans', ui-sans-serif, system-ui, sans-serif;\n  font-size: 16px;\n  line-height: 1.5;\n}\n.app * { box-sizing: border-box; }\nbutton, input { font: inherit; }\nbutton { cursor: pointer; }\na { color: inherit; text-decoration: none; }\n.icon { display: inline-block; width: 18px; height: 18px; color: var(--ink-soft); font-size: 18px; line-height: 1; flex: 0 0 auto; }\n.topbar { min-height: 72px; display: grid; grid-template-columns: auto minmax(240px, 420px) 1fr; align-items: center; gap: 42px; padding: 0 max(28px, calc((100vw - 1290px) / 2)); background: var(--surface); border-bottom: 1px solid var(--line); }\n.brand { display: inline-flex; align-items: center; gap: 11px; min-width: max-content; color: var(--ink); font-weight: 700; letter-spacing: -.02em; line-height: 1.1; }\n.brand-mark { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; color: #fff; background: var(--brand); font-size: 16px; font-weight: 700; }\n.brand-copy small { display: block; margin-top: 4px; color: var(--ink-faint); font-size: 12px; font-weight: 400; letter-spacing: 0; }\n.search { height: 42px; display: flex; align-items: center; gap: 10px; padding: 0 13px; color: var(--ink-faint); background: var(--surface-soft); border: 1px solid var(--line); border-radius: 8px; font-size: 14px; }\n.nav { display: flex; align-items: center; justify-content: flex-end; gap: 7px; }\n.nav a { min-height: 42px; display: inline-flex; align-items: center; gap: 7px; padding: 0 10px; color: var(--ink-soft); border-bottom: 2px solid transparent; font-size: 14px; font-weight: 600; }\n.nav a .icon { width: 17px; height: 17px; font-size: 17px; }\n.nav a.active { color: var(--brand-deep); border-bottom-color: var(--brand); }\n.main { width: min(1290px, 100%); flex: 1; margin: 0 auto; padding: 34px 28px 28px; }\n.support-grid { display: grid; grid-template-columns: minmax(0, 840px) 270px; gap: 48px; align-items: start; }\n.primary { min-width: 0; }\n.page-heading { margin-bottom: 20px; }\nh1 { margin: 0; color: var(--ink); font-size: 30px; font-weight: 700; line-height: 1.2; letter-spacing: -.035em; }\n.order-context { padding: 15px 0 14px; border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }\n.order-topline { display: flex; align-items: center; justify-content: space-between; gap: 14px; }\n.order-id { font-family: 'Fira Code', ui-monospace, monospace; font-size: 17px; font-weight: 600; letter-spacing: -.03em; }\n.order-status { display: inline-flex; align-items: center; min-height: 27px; padding: 2px 9px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-soft); background: var(--surface); font-size: 13px; font-weight: 600; text-transform: capitalize; }\n.order-meta { display: flex; flex-wrap: wrap; gap: 5px 22px; margin-top: 7px; color: var(--ink-soft); font-size: 14px; }\n.order-meta strong { color: var(--ink); font-weight: 600; }\n.order-line { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; padding: 11px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 15px; }\n.order-line .item-name { font-weight: 600; }\n.order-line .item-qty { margin-left: 5px; color: var(--ink-faint); font-weight: 400; }\n.order-line .amount, .order-total strong { font-variant-numeric: tabular-nums; }\n.order-total { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 8px; font-size: 14px; }\n.order-total strong { font-size: 16px; font-weight: 700; }\n.thread { min-height: 504px; display: flex; flex-direction: column; margin-top: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }\n.thread-log { flex: 1; display: flex; flex-direction: column; justify-content: flex-start; gap: 20px; padding: 27px 28px 22px; }\n.greeting { display: flex; align-items: flex-start; gap: 12px; max-width: 680px; }\n.assistant-mark { display: grid; width: 30px; height: 30px; flex: 0 0 auto; place-items: center; margin-top: 1px; color: var(--ink-soft); background: var(--surface-soft); border-radius: 50%; }\n.assistant-mark .icon { width: 16px; height: 16px; font-size: 16px; }\n.greeting-copy { max-width: 62ch; padding-top: 2px; color: var(--ink); font-size: 16px; line-height: 1.55; }\n.issue-area { margin-left: 42px; }\n.issue-area p { margin: 0 0 10px; color: var(--ink-soft); font-size: 14px; }\n.issue-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }\n.issue-option { min-height: 44px; display: flex; align-items: center; padding: 9px 12px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 7px; font-size: 14px; font-weight: 500; text-align: left; }\n.issue-option:hover { border-color: var(--brand); background: var(--brand-soft); }\n.composer { padding: 16px 22px 18px; border-top: 1px solid var(--line); }\n.composer label { display: block; margin-bottom: 7px; color: var(--ink-soft); font-size: 13px; font-weight: 600; }\n.compose-row { display: flex; align-items: center; gap: 9px; }\n.compose-row input { width: 100%; min-width: 0; min-height: 48px; padding: 10px 14px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; font-size: 15px; }\n.compose-row input::placeholder { color: var(--ink-faint); opacity: 1; }\n.compose-row input:focus { outline: 2px solid var(--brand); outline-offset: 2px; }\n.send { width: 48px; height: 48px; display: grid; flex: 0 0 auto; place-items: center; padding: 0; color: #fff; background: var(--brand); border: 1px solid var(--brand); border-radius: 8px; }\n.send .icon { color: #fff; width: 19px; height: 19px; font-size: 19px; }\n.send:hover { background: var(--brand-deep); }\n.secondary { display: flex; flex-direction: column; gap: 28px; padding-top: 58px; }\n.mode-block h2 { margin: 0 0 11px; color: var(--ink); font-size: 17px; font-weight: 600; letter-spacing: -.01em; }\n.mode-switch { display: grid; gap: 7px; }\n.mode { min-height: 46px; display: flex; align-items: center; gap: 10px; padding: 0 12px; color: var(--ink-soft); background: transparent; border: 1px solid var(--line); border-radius: 7px; font-size: 14px; font-weight: 600; text-align: left; }\n.mode .icon { width: 17px; height: 17px; font-size: 17px; }\n.mode.active { color: var(--brand-deep); background: var(--brand-soft); border-color: #f0b98f; }\n.mode.active .icon { color: var(--brand-deep); }\n.safety-note { padding-top: 18px; border-top: 1px solid var(--line-strong); }\n.note-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; color: var(--ink-soft); font-size: 14px; font-weight: 600; }\n.note-head .icon { width: 17px; height: 17px; font-size: 17px; color: var(--ink-soft); }\n.safety-note p { max-width: 30ch; margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.55; }\n.footer { width: min(1290px, 100%); margin: 0 auto; padding: 14px 28px 18px; color: var(--ink-faint); border-top: 1px solid var(--line); font-size: 13px; text-align: center; }\n@media (max-width: 1080px) {\n  .topbar { grid-template-columns: auto 1fr; gap: 18px; padding: 0 22px; }\n  .search { display: none; }\n  .support-grid { grid-template-columns: minmax(0, 1fr) 238px; gap: 28px; }\n}\n@media (max-width: 760px) {\n  .topbar { grid-template-columns: 1fr; gap: 0; padding: 9px 14px 0; }\n  .brand { min-height: 43px; }\n  .nav { justify-content: space-between; gap: 0; margin: 3px -5px 0; }\n  .nav a { min-height: 43px; justify-content: center; gap: 5px; padding: 0 7px; font-size: 12px; }\n  .nav a .icon { width: 16px; height: 16px; font-size: 16px; }\n  .main { padding: 24px 16px; }\n  .support-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }\n  .primary { order: 1; }\n  .secondary { order: 2; padding-top: 0; gap: 17px; }\n  .page-heading { margin-bottom: 15px; }\n  h1 { font-size: 25px; }\n  .thread { min-height: 470px; margin-top: 16px; }\n  .thread-log { padding: 21px 16px 18px; }\n  .issue-area { margin-left: 0; }\n  .issue-options { grid-template-columns: 1fr; }\n  .composer { padding: 14px 14px 16px; }\n  .footer { padding: 13px 18px 18px; }\n}\n@media (max-width: 390px) {\n  .nav a { flex-direction: column; gap: 2px; padding: 3px 5px; font-size: 11px; }\n  .brand-copy small { display: none; }\n  .order-meta { gap: 5px 12px; }\n  .order-id { font-size: 15px; }\n}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"app layout container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"site top bar\">\n        <a aria-label=\"Refund Store home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand link with logo and name\" href=\"#\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark\">\n                R\n            </span>\n            <span class=\"brand-copy\" data-kid=\"1-1-1-2\" data-name=\"brand name and tagline\">\n                Refund Store\n                <small data-kid=\"1-1-1-2-1\" data-name=\"brand tagline text\">\n                    everyday finds, clearly handled\n                </small>\n            </span>\n        </a>\n        <div class=\"search\" data-kid=\"1-1-2\" data-name=\"search field placeholder bar\" role=\"search\">\n            <i aria-hidden=\"true\" class=\"icon icon-search\" data-kid=\"1-1-2-1\" data-name=\"search field magnifier icon\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"search field placeholder text\">\n                What are you looking for?\n            </span>\n        </div>\n        <nav aria-label=\"Shop navigation\" class=\"nav\" data-kid=\"1-1-3\" data-name=\"main navigation menu\">\n            <a data-kid=\"1-1-3-1\" data-name=\"shop navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon icon-shopping-bag\" data-kid=\"1-1-3-1-1\" data-name=\"shopping bag icon\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"shop navigation label\">\n                    Shop\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-2\" data-name=\"orders navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon icon-package\" data-kid=\"1-1-3-2-1\" data-name=\"package box icon\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\" data-name=\"orders navigation label\">\n                    Orders\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-3-3\" data-name=\"help navigation link (active)\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon icon-message-square\" data-kid=\"1-1-3-3-1\" data-name=\"messages chat icon\">\n                </i>\n                <span data-kid=\"1-1-3-3-2\" data-name=\"help navigation label\">\n                    Help\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-4\" data-name=\"account navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon icon-user-round\" data-kid=\"1-1-3-4-1\" data-name=\"user silhouette icon\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\" data-name=\"account navigation label\">\n                    Account\n                </span>\n            </a>\n            <a data-kid=\"1-1-3-5\" data-name=\"cart navigation link\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"icon icon-shopping-cart\" data-kid=\"1-1-3-5-1\" data-name=\"shopping cart icon\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\" data-name=\"cart navigation label\">\n                    Cart\n                </span>\n            </a>\n        </nav>\n    </header>\n    <main class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"support-grid\" data-kid=\"1-2-1\" data-name=\"support page two-column grid\">\n            <section aria-labelledby=\"page-title\" class=\"primary\" data-kid=\"1-2-1-1\" data-name=\"primary support column\">\n                <header class=\"page-heading\" data-kid=\"1-2-1-1-1\" data-name=\"page heading section\">\n                    <h1 data-kid=\"1-2-1-1-1-1\" data-name=\"page title heading\" id=\"page-title\">\n                        Get help with an order\n                    </h1>\n                </header>\n                <section aria-label=\"About this order\" class=\"order-context\" data-kid=\"1-2-1-1-2\" data-name=\"order summary panel\">\n                    <div class=\"order-topline\" data-kid=\"1-2-1-1-2-1\" data-name=\"order id and status row\">\n                        <strong class=\"order-id\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"order id label\">\n                            ORD-DEMO-02\n                        </strong>\n                        <span class=\"order-status\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"order status badge\">\n                            delivered\n                        </span>\n                    </div>\n                    <div class=\"order-meta\" data-kid=\"1-2-1-1-2-2\" data-name=\"order meta row\">\n                        <span data-kid=\"1-2-1-1-2-2-1\" data-name=\"placed date item\">\n                            Placed\n                            <strong data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"placed date value\">\n                                27/09/2026\n                            </strong>\n                        </span>\n                        <span data-kid=\"1-2-1-1-2-2-2\" data-name=\"payment status item\">\n                            Payment\n                            <strong data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"payment status value\">\n                                settled\n                            </strong>\n                        </span>\n                    </div>\n                    <div class=\"order-line\" data-kid=\"1-2-1-1-2-3\" data-name=\"order line item row\">\n                        <span data-kid=\"1-2-1-1-2-3-1\" data-name=\"line item name with quantity\">\n                            <span class=\"item-name\" data-kid=\"1-2-1-1-2-3-1-1\" data-name=\"line item product name\">\n                                Aurora Desk Lamp\n                            </span>\n                            <span class=\"item-qty\" data-kid=\"1-2-1-1-2-3-1-2\" data-name=\"line item quantity text\">\n                                ×1\n                            </span>\n                        </span>\n                        <span class=\"amount\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"line item price\">\n                            $129.00\n                        </span>\n                    </div>\n                    <div class=\"order-total\" data-kid=\"1-2-1-1-2-4\" data-name=\"order total row\">\n                        <span data-kid=\"1-2-1-1-2-4-1\" data-name=\"total label text\">\n                            Total paid\n                        </span>\n                        <strong data-kid=\"1-2-1-1-2-4-2\" data-name=\"total amount value\">\n                            $129.00\n                        </strong>\n                    </div>\n                </section>\n                <section aria-label=\"Refund help conversation\" class=\"thread\" data-kid=\"1-2-1-1-3\" data-name=\"refund help chat panel\">\n                    <div class=\"thread-log\" data-kid=\"1-2-1-1-3-1\" data-name=\"chat message log area\">\n                        <div class=\"greeting\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"assistant greeting bubble\">\n                            <span class=\"assistant-mark\" data-kid=\"1-2-1-1-3-1-1-1\" data-name=\"assistant avatar circle\">\n                                <i aria-hidden=\"true\" class=\"icon icon-message-circle\" data-kid=\"1-2-1-1-3-1-1-1-1\" data-name=\"messages bubble icon\">\n                                </i>\n                            </span>\n                            <p class=\"greeting-copy\" data-kid=\"1-2-1-1-3-1-1-2\" data-name=\"assistant greeting copy\">\n                                Tell me what went wrong with this order and I'll check what the refund policy allows.\n                            </p>\n                        </div>\n                        <div class=\"issue-area\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"common issues prompt area\">\n                            <p data-kid=\"1-2-1-1-3-1-2-1\" data-name=\"common issues prompt label\">\n                                Common reasons\n                            </p>\n                            <div class=\"issue-options\" data-kid=\"1-2-1-1-3-1-2-2\" data-name=\"issue option buttons grid\">\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-1\" data-name=\"issue option button - arrived damaged\" type=\"button\">\n                                    Arrived damaged\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-2\" data-name=\"issue option button - wrong item\" type=\"button\">\n                                    Wrong item sent\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-3\" data-name=\"issue option button - not as described\" type=\"button\">\n                                    Not as described\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-4\" data-name=\"issue option button - late delivery\" type=\"button\">\n                                    Late delivery\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-5\" data-name=\"issue option button - missing from box\" type=\"button\">\n                                    Missing from the box\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-6\" data-name=\"issue option button - charged twice\" type=\"button\">\n                                    Charged twice\n                                </button>\n                                <button class=\"issue-option\" data-kid=\"1-2-1-1-3-1-2-2-7\" data-name=\"issue option button - return it\" type=\"button\">\n                                    I want to return it\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                    <form class=\"composer\" data-kid=\"1-2-1-1-3-2\" data-name=\"message composer form\">\n                        <label data-kid=\"1-2-1-1-3-2-1\" data-name=\"composer field label\" for=\"message\">\n                            Describe the problem\n                        </label>\n                        <div class=\"compose-row\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"composer input row\">\n                            <input data-kid=\"1-2-1-1-3-2-2-1\" data-name=\"message input field\" id=\"message\" placeholder=\"Describe what went wrong…\" type=\"text\"/>\n                            <button aria-label=\"Send\" class=\"send\" data-kid=\"1-2-1-1-3-2-2-2\" data-name=\"send button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"icon icon-send\" data-kid=\"1-2-1-1-3-2-2-2-1\" data-name=\"send arrow icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </form>\n                </section>\n            </section>\n            <aside aria-label=\"Help options and policy information\" class=\"secondary\" data-kid=\"1-2-1-2\" data-name=\"secondary sidebar\">\n                <section class=\"mode-block\" data-kid=\"1-2-1-2-1\" data-name=\"help mode section\">\n                    <h2 data-kid=\"1-2-1-2-1-1\" data-name=\"help mode heading\">\n                        Help mode\n                    </h2>\n                    <div aria-label=\"Assistant mode\" class=\"mode-switch\" data-kid=\"1-2-1-2-1-2\" data-name=\"mode selector group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"mode active\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"refund help mode button (active)\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon icon-message-square\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"messages chat icon\">\n                            </i>\n                            Refund help\n                        </button>\n                        <button aria-pressed=\"false\" class=\"mode\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"shopping help mode button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon icon-search\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"search magnifier icon\">\n                            </i>\n                            Shopping help\n                        </button>\n                    </div>\n                </section>\n                <section class=\"safety-note\" data-kid=\"1-2-1-2-2\" data-name=\"policy safety note section\">\n                    <div class=\"note-head\" data-kid=\"1-2-1-2-2-1\" data-name=\"policy safety note heading row\">\n                        <i aria-hidden=\"true\" class=\"icon icon-shield-check\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"shield check icon\">\n                        </i>\n                        <span data-kid=\"1-2-1-2-2-1-2\" data-name=\"policy safety note heading text\">\n                            How refund help works\n                        </span>\n                    </div>\n                    <p data-kid=\"1-2-1-2-2-2\" data-name=\"policy safety note body text\">\n                        Every answer comes from a written refund rule, not from a model’s opinion. A human checks anything money is involved in.\n                    </p>\n                </section>\n            </aside>\n        </div>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\" data-name=\"footer with disclaimer\">\n        A demo storefront. Every order here is real, in the same database the refund policy reads.\n    </footer>\n</div>\n",
