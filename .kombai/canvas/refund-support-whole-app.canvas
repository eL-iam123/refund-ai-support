pan class=\"queue-top\" data-kid=\"1-2-3-1-3-3-1\" data-name=\"queue item top row\">\n                            <span class=\"queue-name\" data-kid=\"1-2-3-1-3-3-1-1\" data-name=\"customer name\">\n                                Smoke Two\n                            </span>\n                            <span class=\"status-waiting\" data-kid=\"1-2-3-1-3-3-1-2\" data-name=\"waiting status pill\">\n                                <span class=\"status-dot\" data-kid=\"1-2-3-1-3-3-1-2-1\" data-name=\"status indicator dot\">\n                                </span>\n                                Waiting\n                            </span>\n                        </span>\n                        <span class=\"queue-order\" data-kid=\"1-2-3-1-3-3-2\" data-name=\"order id snippet\">\n                            …99e5-75094918ab69\n                        </span>\n                        <span class=\"queue-meta\" data-kid=\"1-2-3-1-3-3-3\" data-name=\"queue item meta row\">\n                            <span data-kid=\"1-2-3-1-3-3-3-1\" data-name=\"message count\">\n                                2 messages\n                            </span>\n                            <time data-kid=\"1-2-3-1-3-3-3-2\" data-name=\"last message time\">\n                                7 Oct, 15:19\n                            </time>\n                        </span>\n                        <span class=\"queue-scope\" data-kid=\"1-2-3-1-3-3-4\" data-name=\"case scope summary\">\n                            1 item in this case\n                        </span>\n                    </button>\n                </div>\n                <div class=\"queue-footer\" data-kid=\"1-2-3-1-4\" data-name=\"queue footer note\">\n                    Showing recent conversations · Select a row to review\n                </div>\n            </aside>\n            <section aria-label=\"Selected conversation with Sam Okonkwo\" class=\"conversation\" data-kid=\"1-2-3-2\" data-name=\"selected conversation panel\">\n                <header class=\"conversation-head\" data-kid=\"1-2-3-2-1\" data-name=\"conversation header\">\n                    <div class=\"case-heading-row\" data-kid=\"1-2-3-2-1-1\" data-name=\"case heading row\">\n                        <div data-kid=\"1-2-3-2-1-1-1\" data-name=\"customer identity block\">\n                            <h2 class=\"customer-title\" data-kid=\"1-2-3-2-1-1-1-1\" data-name=\"customer name heading\">\n                                Sam Okonkwo\n                            </h2>\n                            <div class=\"case-meta\" data-kid=\"1-2-3-2-1-1-1-2\" data-name=\"case metadata row\">\n                                <span data-kid=\"1-2-3-2-1-1-1-2-1\" data-name=\"order field label\">\n                                    Order\n                                </span>\n                                <span class=\"mono\" data-kid=\"1-2-3-2-1-1-1-2-2\" data-name=\"order id value\">\n                                    …90b3-b5208acefe4f\n                                </span>\n                                <span class=\"meta-separator\" data-kid=\"1-2-3-2-1-1-1-2-3\" data-name=\"metadata separator\">\n                                    ·\n                                </span>\n                                <span data-kid=\"1-2-3-2-1-1-1-2-4\" data-name=\"item count value\">\n                                    1 item\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"case-actions\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"case action buttons\">\n                            <button class=\"btn-primary\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"takeover primary button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"icon icon-headset\" data-kid=\"1-2-3-2-1-1-2-1-1\" data-name=\"headset icon\">\n                                </i>\n                                Take over\n    