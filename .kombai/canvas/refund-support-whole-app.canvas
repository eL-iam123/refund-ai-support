        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--ink:#1c1917;--ink-soft:#57534e;--ink-faint:#78716c;--page:#f7f5f2;--surface:#fffdfa;--surface-soft:#f3f1ed;--line:#e7e2da;--line-strong:#d6cec3;--brand:#e85d04;--brand-deep:#c94800;--brand-soft:#fff0e5;--ok:#087443;--ok-soft:#eaf8f0;--no:#b42318;--no-soft:#fff0ef;--wait:#805800;--wait-soft:#fff5d9;--font:'Fira Sans',sans-serif;--mono:'Fira Code',monospace}\n.case-app{height:100vh;min-height:760px;display:flex;flex-direction:column;background:var(--page);color:var(--ink);font:15px/1.48 var(--font);overflow:hidden}\n.case-app *{box-sizing:border-box}\n.case-app a{color:inherit;text-decoration:none}\n.case-app button,.case-app input{font:inherit}\n.case-topbar{height:70px;flex:none;display:flex;align-items:center;gap:34px;padding:0 36px;background:#1f1d1b;color:#f9f7f4;border-bottom:1px solid #332f2b}\n.case-brand{display:flex;align-items:center;gap:11px;min-width:188px;font-size:16px;font-weight:700;letter-spacing:-.02em}\n.brand-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:9px;background:#fff;color:#1f1d1b;font-weight:800;font-size:17px}\n.brand-detail{display:grid;line-height:1.1}.brand-detail small{margin-top:4px;color:#aaa39b;font-size:12px;font-weight:400;letter-spacing:0}\n.case-nav{height:100%;display:flex;align-items:center;gap:5px;flex:1}\n.case-nav a,.signout{height:42px;display:inline-flex;align-items:center;gap:9px;padding:0 12px;border:1px solid transparent;border-radius:7px;color:#d0cbc5;font-size:14px;font-weight:500;white-space:nowrap}\n.case-nav a.active{position:relative;background:#34302c;color:white;border-color:#49433d}\n.case-nav a.active:after{position:absolute;right:12px;bottom:-15px;left:12px;height:2px;background:#f0782f;content:''}\n.case-nav a:hover,.signout:hover{color:white;background:#302c28}\n.case-nav .icon,.signout .icon{font-size:16px;color:#c7c0b8}\n.signout{margin-left:auto;white-space:nowrap;background:transparent;color:#c5beb7}\n.case-main{width:100%;max-width:1520px;min-height:0;flex:1;margin:0 auto;padding:17px 28px 20px;display:grid;grid-template-rows:auto auto minmax(0,1fr);gap:13px}\n.page-line{display:flex;align-items:center;justify-content:space-between;min-height:33px}\n.page-line h1{margin:0;font-size:22px;font-weight:600;letter-spacing:-.035em;line-height:1.15}\n.page-line .view-history{display:inline-flex;align-items:center;gap:6px;color:#49433d;font-size:13px;font-weight:600;text-decoration:underline;text-decoration-color:#b8afa5;text-underline-offset:3px}\n.page-line .view-history:hover{color:var(--brand-deep);text-decoration-color:var(--brand)}\n.metrics-strip{min-height:69px;display:flex;align-items:center;padding:11px 18px;background:#fffdfa;border:1px solid var(--line);border-radius:10px}\n.metric{min-height:38px;display:flex;align-items:center;gap:9px;padding:0 22px;border-left:1px solid var(--line);white-space:nowrap}\n.metric:first-child{padding-left:3px;border-left:0}\n.metric-label{color:#625c55;font-size:13px;font-weight:600}\n.metric-value{font-variant-numeric:tabular-nums;font-size:19px;font-weight:700;letter-spacing:-.02em}\n.metric.waiting .metric-value{color:var(--wait)}\n.metric.decisions{flex:1;min-width:0;align-items:center;flex-wrap:wrap;white-space:normal}\n.metric-subline{display:flex;align-items:center;gap:7px;flex-wrap:wrap}\n.decision-count{display:inline-flex;align-items:center;min-height:26px;padding:2px 9px;border:1px solid;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap}\n.approved{color:var(--ok);background:var(--ok-soft);border-color:#abefc6}\n.denied{color:var(--no);background:var(--no-soft);border-color:#fecdca}\n.escalated{color:var(--wait);background:var(--wait-soft);border-color:#eed48e}\n.metric-note{margin-left:auto;color:var(--ink-faint);font-size:12px;white-space:nowrap}\n.workspace{min-height:0;display:grid;grid-template-columns:266px minmax(0,1fr) 352px;gap:15px;align-items:stretch}\n.queue,.conversation,.record{min-width:0;min-height:0;background:var(--surface);border:1px solid var(--line);border-radius:10px}\n.queue{display:flex;flex-direction:column;overflow:hidden}\n.queue-heading{min-height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 15px;border-bottom:1px solid var(--line)}\n.queue-title{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:700}\n.queue-title .icon{font-size:17px;color:#645d55}\n.queue-count{color:var(--ink-faint);font-size:13px;font-weight:500}\n.queue-search{margin:12px 12px 5px;position:relative}\n.queue-search .icon{position:absolute;left:11px;top:11px;color:#807970;font-size:15px}\n.queue-search input{width:100%;height:37px;padding:0 12px 0 34px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink);font-size:13px;outline:0}\n.queue-list{min-height:0;flex:1;overflow:auto;padding:5px 8px 10px}\n.queue-item{display:block;width:100%;padding:11px 10px 10px;border:0;border-bottom:1px solid #eeeae4;border-radius:0;background:transparent;color:var(--ink);text-align:left;cursor:pointer}\n.queue-item:hover{background:#faf8f4}\n.queue-item.selected{margin:3px 0 4px;padding-left:10px;border-bottom-color:#f3c9a8;border-radius:7px;background:#fff4e9;box-shadow:inset 3px 0 0 var(--brand)}\n.queue-top{display:flex;align-items:center;justify-content:space-between;gap:8px}\n.queue-name{overflow:hidden;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}\n.status-waiting{display:inline-flex;align-items:center;gap:5px;padding:3px 7px;border-radius:99px;background:var(--wait-soft);color:var(--wait);font-size:11px;font-weight:700;white-space:nowrap}\n.status-dot{width:6px;height:6px;border-radius:50%;background:#b07b00}\n.queue-order{margin-top:6px;color:#6d665e;font:12px/1.4 var(--mono);white-space:nowrap}\n.queue-meta{margin-top:4px;display:flex;align-items:center;justify-content:space-between;gap:8px;color:var(--ink-faint);font-size:12px}\n.queue-scope{margin-top:7px;color:#716960;font-size:12px}\n.queue-footer{padding:11px 14px;border-top:1px solid var(--line);color:var(--ink-faint);font-size:12px}\n.conversation{display:flex;flex-direction:column;overflow:hidden}\n.conversation-head{padding:15px 19px 13px;border-bottom:1px solid var(--line);background:#fffdfa}\n.case-heading-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}\n.customer-title{margin:0;font-size:21px;font-weight:650;letter-spacing:-.025em;line-height:1.2}\n.case-meta{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:6px;color:#5f5851;font-size:13px}\n.case-meta .mono{font:12px var(--mono);color:#57514a}\n.meta-separator{color:#b7afa5}\n.case-actions{display:flex;align-items:center;gap:8px;flex:none}\n.btn-primary{min-height:39px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 14px;border:1px solid #cf5106;border-radius:7px;background:var(--brand);color:#fff;font-size:13px;font-weight:700;cursor:pointer}\n.btn-primary:hover{background:var(--brand-deep)}\n.btn-quiet{min-height:38px;display:inline-flex;align-items:center;justify-content:center;padding:0 10px;border:1px solid transparent;border-radius:7px;background:transparent;color:#645d55;font-size:12px;font-weight:600;cursor:pointer}\n.btn-quiet:hover{background:#f4f1ed;color:var(--ink)}\n.status-band{display:grid;grid-template-columns:1.1fr 1fr 1.1fr;gap:0;margin-top:14px;padding:10px 12px;border:1px solid #e9e3d9;border-radius:7px;background:#f8f6f2}\n.status-cell{min-width:0;padding:0 12px;border-left:1px solid #e2dcd2}\n.status-cell:first-child{padding-left:0;border-left:0}\n.status-label{display:block;color:#716960;font-size:11px;font-weight:700;letter-spacing:.035em}\n.status-content{margin-top:3px;display:flex;align-items:center;gap:7px;min-height:20px;color:#28231f;font-size:13px;font-weight:650}\n.amount-copy{color:#50483e;font-size:12px;font-weight:500}\n.convo-toolbar{min-height:45px;display:flex;align-items:center;justify-content:space-between;padding:0 19px;border-bottom:1px solid #eeeae4}\n.section-title{font-size:14px;font-weight:700;letter-spacing:-.01em}\n.thread-filter{display:flex;align-items:center;gap:5px;color:#6b645c;font-size:12px}\n.thread-filter button{min-height:28px;padding:0 9px;border:1px solid var(--line);border-radius:6px;background:#fff;color:#514b44;font-size:12px;font-weight:600}\n.thread-filter button.active{border-color:#d8cfc3;background:#f3f0eb;color:#302b26}\n.thread-body{min-height:0;flex:1;overflow:auto;padding:17px 20px 15px;display:flex;flex-direction:column;gap:14px;background:#fffdfa}\n.thread-date{align-self:center;padding:3px 10px;border-radius:99px;background:#f4f1ed;color:#716960;font-size:11px;font-weight:600}\n.turn{max-width:min(98%,680px);padding:0 0 8px;border-bottom:1px solid #eeeae4}\n.turn:last-of-type{border-bottom:0}\n.turn-header{display:flex;align-items:center;gap:8px;margin-bottom:5px;color:#655e56;font-size:12px;font-weight:600}\n.turn-header .icon{font-size:15px;color:#766e65}\n.turn-header time{color:#888076;font-size:12px;font-weight:400}\n.turn-copy{margin:0;color:#26211d;font-size:14px;line-height:1.45;white-space:pre-wrap}\n.turn.assistant{margin-left:10px;padding:9px 11px;border:1px solid #e9e4dc;border-radius:7px;background:#f6f4f0}\n.assistant-copy-label{display:block;margin-bottom:4px;color:#665e55;font-size:11px;font-weight:700}\n.reply-slot{padding:12px 17px 14px;border-top:1px solid var(--line);background:#fffdfa}\n.reply-guidance{display:flex;align-items:center;gap:7px;margin-bottom:8px;color:#655e56;font-size:12px}\n.reply-guidance .icon{color:#8b7e6f;font-size:15px}\n.reply-form{display:flex;align-items:center;gap:8px}\n.reply-form input{height:43px;min-width:0;flex:1;padding:0 12px;border:1px solid #d9d1c6;border-radius:7px;background:#f7f5f2;color:#423c35;font-size:13px;outline:0}\n.reply-form input::placeholder{color:#837a70}\n.reply-form input:disabled{opacity:1;color:#6d655d;background:#f3f1ed;cursor:not-allowed}\n.attach-button{width:40px;height:40px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:7px;background:white;color:#655d54;font-size:17px;cursor:pointer}\n.reply-send{width:42px;height:42px;display:grid;place-items:center;border:1px solid #d8d1c7;border-radius:7px;background:#ece9e4;color:#766d63;font-size:16px;cursor:not-allowed}\n.reply-disabled-note{margin-top:7px;color:#766e65;font-size:12px}\n.record{display:flex;flex-direction:column;overflow:hidden}\n.record-head{min-height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-bottom:1px solid var(--line)}\n.record-title{margin:0;font-size:15px;font-weight:700}\n.record-title-link{color:#655d54;font-size:12px;font-weight:600;text-decoration:underline!important;text-decoration-color:#b9b0a5!important;text-underline-offset:3px}\n.record-scroll{min-height:0;flex:1;overflow:auto;padding:15px 17px 18px}\n.record-section{padding:0 0 14px;margin:0 0 14px;border-bottom:1px solid #e9e4dc}\n.record-section:last-child{margin-bottom:0;padding-bottom:0;border:0}\n.record-section h3{margin:0 0 8px;color:#504940;font-size:13px;font-weight:700;letter-spacing:0}\n.record-section p{margin:0;color:#3e3832;font-size:13px;line-height:1.5}\n.record-quote{padding-left:11px;border-left:2px solid #c9c0b5;color:#38322c!important;font-size:13px!important;line-height:1.5}\n.record-assistant{margin-top:8px;padding-left:11px;border-left:2px solid #ddd6cc;color:#5a534b!important;font-size:12px!important;line-height:1.55!important}\n.no-evidence{display:flex;align-items:flex-start;gap:8px;color:#4b443d!important}\n.no-evidence .icon{margin-top:2px;color:#746a5f;font-size:15px}\n.claim-rows{display:grid;grid-template-columns:70px minmax(0,1fr);gap:7px 8px;margin:0}\n.claim-rows dt{color:#766e65;font-size:12px}\n.claim-rows dd{margin:0;color:#302a25;font-size:13px;font-weight:600;line-height:1.42}\n.decision-mark{display:inline-flex;align-items:center;gap:6px;min-height:24px;padding:2px 8px;border-radius:99px;background:var(--wait-soft);color:var(--wait);font-size:11px;font-weight:700;text-transform:uppercase}\n.policy-summary{margin-top:9px;padding:10px 11px;border-radius:6px;background:#f5f2ed;color:#39332d;font-size:12px;line-height:1.5}\n.policy-summary strong{color:#201b17;font-weight:700}\n.rule-link{display:inline-flex;align-items:center;gap:6px;margin-top:9px;color:#484139;font-size:12px;font-weight:650;text-decoration:underline!important;text-decoration-color:#b9b0a5!important;text-underline-offset:3px}\n.rule-link:hover,.record-title-link:hover{color:var(--brand-deep)}\n.record-facts{display:grid;gap:7px}\n.record-fact{display:flex;justify-content:space-between;gap:10px;color:#5d554c;font-size:12px}\n.record-fact strong{color:#302a25;font-size:12px;font-weight:600}\n.footer-note{margin-top:10px;color:#736b62;font-size:11px;line-height:1.4}\n@media(max-width:1150px){.case-topbar{gap:15px;padding:0 20px}.case-nav{gap:0}.case-nav a{padding:0 9px;font-size:13px}.case-nav .icon{display:none}.signout{padding:0 8px}.case-main{padding:15px 18px 18px}.workspace{grid-template-columns:230px minmax(0,1fr) 310px;gap:11px}.metric{padding:0 13px}.metric-note{display:none}.status-band{grid-template-columns:1fr 1fr 1.2fr}}\n@media(max-width:900px){.case-app{height:auto;min-height:100vh;overflow:visible}.case-topbar{height:auto;min-height:66px;flex-wrap:wrap;padding:10px 16px;gap:8px}.case-brand{min-width:150px}.case-nav{order:3;flex-basis:100%;height:40px;overflow:auto}.case-nav a{flex:1;justify-content:center;padding:0 8px}.case-nav a.active:after{bottom:-1px}.signout{margin-left:auto}.case-main{display:block;padding:14px 14px 20px}.page-line{margin-bottom:12px}.metrics-strip{margin-bottom:12px;flex-wrap:wrap;gap:5px;padding:9px 11px}.metric{min-height:33px;padding:0 10px}.metric:first-child{padding-left:2px}.metric.decisions{flex-basis:100%;order:5;border-left:0;border-top:1px solid var(--line);padding:7px 0 0}.workspace{grid-template-columns:minmax(210px, .7fr) minmax(0,1.3fr);gap:12px}.queue{max-height:650px}.conversation{min-height:650px}.record{grid-column:1/-1;max-height:430px}.record-scroll{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px}}\n@media(max-width:620px){.case-topbar{gap:7px}.case-brand{font-size:14px}.brand-detail small{display:none}.case-nav{justify-content:space-between}.case-nav a{min-width:48px;padding:0 7px;font-size:11px}.case-nav a .icon{display:block}.case-nav a span{display:none}.case-main{padding:12px 10px 16px}.page-line h1{font-size:19px}.page-line .view-history{font-size:11px}.metrics-strip{align-items:flex-start}.metric{display:grid;gap:1px;align-content:center;padding:0 8px}.metric-label{font-size:11px}.metric-value{font-size:16px}.metric.decisions{display:block}.metric-subline{margin-top:5px}.workspace{display:flex;flex-direction:column}.queue{max-height:205px;flex:none}.queue-list{padding:3px 7px 7px}.queue-item:not(.selected){display:none}.queue-search{margin:9px 9px 2px}.queue-footer{display:none}.conversation{min-height:620px}.case-heading-row{align-items:flex-start}.customer-title{font-size:19px}.case-actions{flex-direction:column;align-items:stretch;gap:3px}.btn-primary{min-height:36px;padding:0 10px;font-size:12px}.btn-quiet{min-height:30px}.status-band{grid-template-columns:1fr;gap:8px;padding:9px 10px}.status-cell{padding:0;border:0}.status-content{margin-top:1px}.convo-toolbar{padding:0 13px}.thread-body{padding:14px 13px}.turn{max-width:100%}.turn.assistant{margin-left:7px}.reply-slot{padding:10px 12px}.record{max-height:none}.record-scroll{display:block}.case-meta{font-size:12px}.case-meta .mono{font-size:11px}}\n</style>\n<div class=\"case-app\" data-kid=\"1\" data-name=\"refund console application shell\">\n    <header class=\"case-topbar\" data-kid=\"1-1\" data-name=\"top application bar\">\n        <a aria-label=\"Refund Console overview\" class=\"case-brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#overview\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram tile\">\n                R\n            </span>\n            <span class=\"brand-detail\" data-kid=\"1-1-1-2\" data-name=\"brand name block\">\n                Refund Console\n                <small data-kid=\"1-1-1-2-1\" data-name=\"brand subtitle tag\">\n                    operations\n                </small>\n            </span>\n        </a>\n        <nav aria-label=\"Staff navigation\" class=\"case-nav\" data-kid=\"1-1-2\" data-name=\"primary staff navigation\">\n            <a data-kid=\"1-1-2-1\" data-name=\"overview nav link\" href=\"#overview\">\n                <i aria-hidden=\"true\" class=\"icon icon-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard grid icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"overview nav label\">\n                    Overview\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-2\" data-name=\"live nav link (active)\" href=\"#live\">\n                <i aria-hidden=\"true\" class=\"icon icon-headset\" data-kid=\"1-1-2-2-1\" data-name=\"headset icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"live nav label\">\n                    Live\n                </span>\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"payouts nav link\" href=\"#payouts\">\n                <i aria-hidden=\"true\" class=\"icon icon-wallet\" data-kid=\"1-1-2-3-1\" data-name=\"wallet icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"payouts nav label\">\n                    Payouts\n                </span>\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"returns nav link\" href=\"#returns\">\n                <i aria-hidden=\"true\" class=\"icon icon-package\" data-kid=\"1-1-2-4-1\" data-name=\"package icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"returns nav label\">\n                    Returns\n                </span>\n            </a>\n            <a data-kid=\"1-1-2-5\" data-name=\"all requests nav link\" href=\"#requests\">\n                <i aria-hidden=\"true\" class=\"icon icon-inbox\" data-kid=\"1-1-2-5-1\" data-name=\"inbox icon\">\n                </i>\n                <span data-kid=\"1-1-2-5-2\" data-name=\"all requests nav label\">\n                    All requests\n                </span>\n            </a>\n            <a data-kid=\"1-1-2-6\" data-name=\"policy nav link\" href=\"#policy\">\n                <i aria-hidden=\"true\" class=\"icon icon-file-text\" data-kid=\"1-1-2-6-1\" data-name=\"file text icon\">\n                </i>\n                <span data-kid=\"1-1-2-6-2\" data-name=\"policy nav label\">\n                    Policy\n                </span>\n            </a>\n        </nav>\n        <a class=\"signout\" data-kid=\"1-1-3\" data-name=\"sign out link\" href=\"#sign-out\">\n            <i aria-hidden=\"true\" class=\"icon icon-log-out\" data-kid=\"1-1-3-1\" data-name=\"log out icon\">\n            </i>\n            <span data-kid=\"1-1-3-2\" data-name=\"sign out label\">\n                Sign out\n            </span>\n        </a>\n    </header>\n    <main class=\"case-main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"page-line\" data-kid=\"1-2-1\" data-name=\"page header row\">\n            <h1 data-kid=\"1-2-1-1\" data-name=\"page title\">\n                Live conversations\n            </h1>\n            <a class=\"view-history\" data-kid=\"1-2-1-2\" data-name=\"view history link\" href=\"#all-requests\">\n                View all request history\n                <i aria-hidden=\"true\" class=\"icon icon-arrow-up-right\" data-kid=\"1-2-