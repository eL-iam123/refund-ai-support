      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root{--ink:#24211e;--ink-soft:#514c46;--ink-muted:#716a61;--paper:#f5f3ef;--surface:#fffdfa;--surface-alt:#f0ede7;--line:#ded8ce;--line-strong:#c9c0b4;--orange:#e85d04;--orange-deep:#b84400;--orange-soft:#fff1e5;--green:#087443;--green-soft:#eaf8f0;--red:#b42318;--red-soft:#fff0ef;--amber:#8a5a00;--amber-soft:#fff5d8;--radius:10px;--sans:'Fira Sans',sans-serif;--mono:'Fira Code',monospace}\n*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.48 var(--sans);-webkit-font-smoothing:antialiased}button,a,input{font:inherit}a{color:inherit;text-decoration:none}button{cursor:pointer}.shell{min-height:100vh}.topbar{height:68px;display:flex;align-items:center;gap:28px;padding:0 28px;background:#201e1b;color:#fff;border-bottom:1px solid #393530}.brand{display:flex;align-items:center;gap:11px;min-width:205px;font-size:15px;font-weight:700;letter-spacing:-.015em}.brand-mark{display:grid;width:34px;height:34px;place-items:center;border-radius:8px;background:var(--orange);color:#fff;font-weight:700}.brand small{display:block;margin-top:2px;color:#bcb5ac;font-size:12px;font-weight:400;letter-spacing:0}.nav{display:flex;align-items:center;gap:3px;min-width:0;flex:1}.nav a,.signout{display:flex;align-items:center;gap:8px;min-height:40px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:#d4cec5;font-size:14px;font-weight:500;white-space:nowrap}.nav a .icon,.signout .icon{font-size:16px;color:#bcb5ac}.nav a.active{background:#34302b;color:#fff;box-shadow:inset 0 -2px var(--orange)}.nav a:hover,.signout:hover{background:#302c27;color:#fff}.signout{margin-left:auto;flex:none;border:1px solid #514b44}.page{max-width:1600px;margin:0 auto;padding:22px 26px 30px}.page-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:17px}.page-heading h1{margin:0;font-size:25px;line-height:1.2;font-weight:700;letter-spacing:-.025em}.page-heading p{margin:4px 0 0;color:var(--ink-soft);font-size:14px}.live-counts{display:flex;align-items:center;gap:20px;padding:8px 0;color:var(--ink-soft);white-space:nowrap}.count{display:flex;align-items:baseline;gap:7px;padding-left:18px;border-left:1px solid var(--line)}.count:first-child{padding-left:0;border-left:0}.count strong{font-size:18px;font-variant-numeric:tabular-nums;color:var(--ink)}.count:first-child strong{color:var(--amber)}.count span{font-size:13px}.workspace{display:grid;grid-template-columns:324px minmax(0,1fr);gap:18px;align-items:stretch;min-height:calc(100vh - 153px)}.queue,.case-pane{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius)}.queue{display:flex;flex-direction:column;max-height:calc(100vh - 153px);overflow:hidden}.queue-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 17px 13px;border-bottom:1px solid var(--line)}.queue-head h2{margin:0;font-size:16px;line-height:1.25}.queue-head span{color:var(--ink-muted);font-size:13px}.queue-filters{display:flex;gap:7px;padding:11px 14px;border-bottom:1px solid var(--line)}.filter{min-height:34px;padding:0 11px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink-soft);font-size:13px;font-weight:600}.filter.selected{border-color:var(--line-strong);background:var(--surface-alt);color:var(--ink)}.queue-scroll{min-height:0;overflow-y:auto;padding:5px 14px 15px}.queue-group{margin:11px 3px 5px;color:var(--ink-muted);font-size:12px;font-weight:700;letter-spacing:.01em}.queue-list{display:grid}.queue-row{display:grid;gap:5px;width:100%;padding:10px 8px 11px;border:0;border-bottom:1px solid #e8e3db;border-radius:0;background:transparent;color:var(--ink);text-align:left}.queue-row.active{padding:11px 10px;background:var(--orange-soft);border-radius:6px;box-shadow:inset 0 0 0 1px #f1c6a7}.queue-row:hover:not(.active){background:#f8f6f2}.row-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.person{overflow:hidden;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.status{display:inline-flex;align-items:center;gap:5px;min-height:23px;padding:1px 8px;border:1px solid #e8d28a;border-radius:999px;background:var(--amber-soft);color:var(--amber);font-size:11px;font-weight:700;line-height:1.2;white-space:nowrap}.status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}.row-meta{display:flex;align-items:center;gap:8px;color:var(--ink-muted);font-size:12px}.row-meta .order{overflow:hidden;flex:1;min-width:0;font-family:var(--mono);text-overflow:ellipsis;white-space:nowrap}.row-meta .date{flex:none}.case-meta{color:var(--ink-muted);font-size:12px}.case-pane{display:flex;flex-direction:column;overflow:hidden}.case-header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;border-bottom:1px solid var(--line)}.case-title{min-width:0}.case-title-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.case-title h2{margin:0;font-size:21px;line-height:1.2;letter-spacing:-.02em}.case-order{margin-top:5px;color:var(--ink-muted);font-size:13px}.case-order code{font:12px var(--mono);color:var(--ink-soft)}.case-actions{display:flex;align-items:center;gap:9px;flex:none}.primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 16px;border:1px solid var(--orange);border-radius:7px;background:var(--orange);color:#fff;font-size:14px;font-weight:700}.primary:hover{background:var(--orange-deep);border-color:var(--orange-deep)}.quiet-link{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 8px;color:var(--ink-soft);font-size:13px;font-weight:600}.quiet-link:hover{color:var(--orange-deep);text-decoration:underline}.boundary{display:grid;grid-template-columns:1.05fr 1.1fr 1.12fr 1.18fr;margin:0 20px;padding:14px 0 15px;border-bottom:1px solid var(--line)}.boundary-cell{display:flex;flex-direction:column;gap:6px;min-width:0;padding:0 15px;border-left:1px solid var(--line)}.boundary-cell:first-child{padding-left:0;border-left:0}.boundary-cell:last-child{padding-right:0}.boundary-label{color:var(--ink-muted);font-size:12px;font-weight:700}.boundary-copy{font-size:14px;line-height:1.4}.boundary-copy strong{font-weight:700}.boundary-copy em{color:var(--ink-soft);font-style:normal}.boundary-result{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.boundary-result strong{font-size:15px}.amount-note{color:var(--ink-soft);font-size:12px}.boundary-action{display:flex;align-items:center;justify-content:space-between;gap:10px}.boundary-action .primary{min-height:36px;padding:0 12px;font-size:13px}.handoff-copy{color:var(--ink-soft);font-size:13px;line-height:1.35}.case-body{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.9fr);gap:18px;min-height:0;padding:16px 20px 20px}.conversation,.case-file{min-width:0}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:11px}.section-head h3{margin:0;font-size:16px}.section-head span{color:var(--ink-muted);font-size:12px}.thread{display:flex;flex-direction:column;gap:9px;min-height:280px;max-height:calc(100vh - 490px);min-height:300px;overflow-y:auto;padding:3px 4px 7px 0}.message{max-width:95%;padding:11px 13px;border-radius:7px;font-size:14px;line-height:1.47}.message.customer{align-self:flex-start;border:1px solid var(--line);background:#f5f3ef}.message.assistant{align-self:flex-start;border:1px solid #e6dfd5;background:#fffdfa}.message.agent{align-self:flex-start;border:1px solid #ded9ef;background:#f5f3ff}.message-head{display:flex;align-items:center;gap:7px;margin-bottom:5px;color:var(--ink-soft);font-size:12px;font-weight:700}.message-head .icon{font-size:14px}.message-head time{color:var(--ink-muted);font-weight:400}.message p{margin:0}.turn-tag{display:inline-flex;align-items:center;gap:5px;margin:0 0 7px;padding:3px 7px;border-radius:4px;background:#f0ede7;color:var(--ink-soft);font-size:11px;font-weight:700}.message.assistant .turn-tag{background:var(--amber-soft);color:var(--amber)}.thread-lock{display:flex;align-items:center;gap:8px;margin:9px 0 0;padding:10px 12px;border:1px dashed var(--line-strong);border-radius:6px;color:var(--ink-soft);font-size:13px}.thread-lock .icon{color:var(--ink-muted)}.thread-lock strong{color:var(--ink)}.composer{display:flex;align-items:center;gap:9px;margin-top:10px;padding-top:11px;border-top:1px solid var(--line)}.composer input{flex:1;min-width:0;min-height:42px;padding:0 12px;border:1px solid var(--line);border-radius:6px;background:#f7f5f2;color:var(--ink-muted);font-size:13px}.composer button{min-height:42px;padding:0 13px;border:1px solid var(--line);border-radius:6px;background:var(--surface-alt);color:var(--ink-muted);font-size:13px;font-weight:600}.composer button:disabled{cursor:not-allowed;opacity:.8}.file-block{padding:0 0 12px;margin-bottom:12px;border-bottom:1px solid var(--line)}.file-block:last-child{border-bottom:0}.file-label{margin-bottom:6px;color:var(--ink-muted);font-size:12px;font-weight:700}.quote{margin:0;padding-left:11px;border-left:2px solid var(--line-strong);font-size:14px;line-height:1.45}.quote+.quote{margin-top:7px}.fact-list{display:grid;gap:7px;margin:0}.fact{display:grid;grid-template-columns:100px minmax(0,1fr);gap:12px;font-size:13px}.fact dt{color:var(--ink-muted)}.fact dd{margin:0;font-weight:600}.decision-note{padding:10px 11px;border:1px solid #eed59a;border-radius:6px;background:var(--amber-soft);color:#573b06;font-size:13px;line-height:1.42}.decision-note strong{display:block;margin-bottom:3px;color:#523700;font-size:14px}.trail-summary{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:9px}.trail-summary strong{font-size:13px}.trail-summary span{color:var(--ink-muted);font-size:12px}.trail-link{display:inline-flex;align-items:center;gap:6px;margin-top:9px;color:var(--orange-deep);font-size:13px;font-weight:700}.trail-link:hover{text-decoration:underline}.secondary-actions{display:flex;justify-content:flex-end;gap:14px;padding:0 20px 13px;color:var(--ink-muted);font-size:12px}.secondary-actions a{color:var(--ink-muted);text-decoration:underline;text-decoration-color:var(--line-strong);text-underline-offset:3px}.secondary-actions a:hover{color:var(--orange-deep)}.queue-footer{margin-top:auto;padding:11px 15px;border-top:1px solid var(--line);background:#faf8f4}.queue-footer p{margin:0;color:var(--ink-muted);font-size:12px;line-height:1.45}.queue-footer strong{color:var(--ink-soft)}.icon{display:inline-block;line-height:1}.icon-layout-dashboard,.icon-headset,.icon-wallet,.icon-package,.icon-inbox,.icon-file-text,.icon-log-out,.icon-message-square,.icon-user-round,.icon-bot,.icon-lock-keyhole,.icon-arrow-up-right,.icon-scale,.icon-circle-check,.icon-chevron-right{width:1em;height:1em;color:inherit}\n@media(max-width:1180px){.topbar{gap:14px;padding:0 18px}.brand{min-width:175px}.nav a{padding:0 9px;font-size:13px}.workspace{grid-template-columns:285px minmax(0,1fr);gap:14px}.boundary{margin:0 16px;grid-template-columns:1fr 1fr}.boundary-cell:nth-child(3){border-left:0;padding-left:0;margin-top:12px}.boundary-cell:nth-child(4){margin-top:12px}.case-header{padding:15px 16px}.case-body{grid-template-columns:minmax(0,1.35fr) minmax(270px,.9fr);padding:15px 16px}.secondary-actions{padding-inline:16px}.page{padding-inline:18px}}\n@media(max-width:900px){.topbar{height:auto;min-height:64px;flex-wrap:wrap;padding:10px 16px;gap:10px}.brand{min-width:150px}.nav{order:3;flex-basis:100%;overflow-x:auto;padding-bottom:2px}.nav a{min-height:38px}.signout{margin-left:auto}.page{padding:17px 15px 24px}.page-heading{align-items:flex-start;flex-direction:column;gap:8px}.live-counts{gap:12px}.workspace{grid-template-columns:minmax(245px,.75fr) minmax(0,1.4fr);min-height:calc(100vh - 205px)}.queue{max-height:calc(100vh - 205px)}.case-body{grid-template-columns:1fr}.thread{max-height:340px}.case-file{display:grid;grid-template-columns:1fr 1fr;gap:14px}.file-block{border-bottom:0;padding-bottom:0}.file-block:nth-child(3){grid-column:1/-1}}\n@media(max-width:680px){.topbar{align-items:center}.brand{font-size:14px}.brand small{font-size:11px}.signout{min-height:36px;padding:0 8px;font-size:12px}.nav a{padding:0 10px}.page{padding:14px 12px 22px}.page-heading h1{font-size:22px}.live-counts{width:100%;justify-content:space-between;gap:6px}.count{gap:5px;padding-left:9px}.count span{font-size:11px}.count strong{font-size:16px}.workspace{display:flex;flex-direction:column;min-height:0}.case-pane{order:0;overflow:visible}.queue{order:1;max-height:290px}.queue-scroll{max-height:220px}.case-header{align-items:flex-start;flex-direction:column}.case-actions{width:100%;justify-content:space-between}.case-title h2{font-size:19px}.case-order code{overflow-wrap:anywhere}.boundary{grid-template-columns:1fr 1fr;gap:0;margin:0 13px;padding:12px 0}.boundary-cell{padding:0 10px}.boundary-cell:nth-child(odd){padding-left:0;border-left:0}.boundary-cell:nth-child(even){padding-right:0}.boundary-cell:nth-child(n+3){margin-top:12px;padding-top:10px;border-top:1px solid var(--line)}.boundary-cell:nth-child(3){padding-left:0}.boundary-copy{font-size:13px}.boundary-action{align-items:flex-start;flex-direction:column}.case-body{padding:13px}.thread{max-height:310px;min-height:220px}.message{max-width:100%;font-size:13px}.case-file{display:block}.file-block{padding-bottom:11px;margin-bottom:11px;border-bottom:1px solid var(--line)}.secondary-actions{padding:0 13px 12px}.queue-footer{display:none}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"page shell\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <a aria-label=\"Refund Console home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark letter\">\n                R\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                Refund Console\n                <small data-kid=\"1-1-1-2-1\" data-name=\"brand sublabel text\">\n                    operations\n                </small>\n            </span>\n        </a>\n        <nav aria-label=\"Staff navigation\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"staff primary navigation\">\n            <a data-kid=\"1-1-2-1\" data-name=\"overview nav link\" href=\"#\">\n                <i class=\"icon icon-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard icon\">\n                </i>\n                Overview\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-2\" data-name=\"live nav link (active)\" href=\"#\">\n                <i class=\"icon icon-headset\" data-kid=\"1-1-2-2-1\" data-name=\"headset icon\">\n                </i>\n                Live\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"payouts nav link\" href=\"#\">\n                <i class=\"icon icon-wallet\" data-kid=\"1-1-2-3-1\" data-name=\"wallet icon\">\n                </i>\n                Payouts\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"returns nav link\" href=\"#\">\n                <i class=\"icon icon-package\" data-kid=\"1-1-2-4-1\" data-name=\"package icon\">\n                </i>\n                Returns\n            </a>\n            <a data-kid=\"1-1-2-5\" data-name=\"all requests nav link\" href=\"#\">\n                <i class=\"icon icon-inbox\" data-kid=\"1-1-2-5-1\" data-name=\"inbox icon\">\n                </i>\n                All requests\n            </a>\n            <a data-kid=\"1-1-2-6\" data-name=\"policy nav link\" href=\"#\">\n                <i class=\"icon icon-file-text\" data-kid=\"1-1-2-6-1\" data-name=\"document icon\">\n                </i>\n                Policy\n            </a>\n        </nav>\n        <button class=\"signout\" data-kid=\"1-1-3\" data-name=\"sign out button\" type=\"button\">\n            <i class=\"icon icon-log-out\" data-kid=\"1-1-3-1\" data-name=\"log out icon\">\n            </i>\n            Sign out\n        </button>\n    </header>\n    <main class=\"page\" data-kid=\"1-2\" data-name=\"main page container\">\n        <div class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"heading title and description wrapper\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">\n                    Live conversations\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Review the conversation, then take over if a person needs to respond.\n                </p>\n            </div>\n            <div aria-label=\"Live queue summary\" class=\"live-counts\" data-kid=\"1-2-1-2\" data-name=\"live queue summary container\">\n                <div class=\"count\" data-kid=\"1-2-1-2-1\" data-name=\"waiting count stat\">\n                    <strong data-kid=\"1-2-1-2-1-1\" data-name=\"waiting count number\">\n                        8\n                    </strong>\n                    <span data-kid=\"1-2-1-2-1-2\" data-name=\"waiting count label\">\n                        waiting for a person\n                    </span>\n                </div>\n                <div class=\"count\" data-kid=\"1-2-1-2-2\" data-name=\"recent conversations count stat\">\n                    <strong data-kid=\"1-2-1-2-2-1\" data-name=\"recent conversations number\">\n                        12\n                    </strong>\n                    <span data-kid=\"1-2-1-2-2-2\" data-name=\"recent conversations label\">\n                        recent conversations\n                    </span>\n                </div>\n                <div class=\"count\" data-kid=\"1-2-1-2-3\" data-name=\"average takeover stat\">\n                    <strong data-kid=\"1-2-1-2-3-1\" data-name=\"average takeover number\">\n                        0 min\n                    </strong>\n                    <span data-kid=\"1-2-1-2-3-2\" data-name=\"average takeover label\">\n                        average takeover\n                    </span>\n                </div>\n            </div>\n        </div>\n        <section aria-label=\"Live conversation workspace\" class=\"workspace\" data-kid=\"1-2-2\" data-name=\"conversation workspace grid\">\n            <aside aria-label=\"Conversation queue\" class=\"queue\" data-kid=\"1-2-2-1\" data-name=\"conversation queue sidebar\">\n                <header class=\"queue-head\" data-kid=\"1-2-2-1-1\" data-name=\"queue header\">\n                    <h2 data-kid=\"1-2-2-1-1-1\" data-name=\"queue section title\">\n                        Conversations\n                    </h2>\n                    <span data-kid=\"1-2-2-1-1-2\" data-name=\"recent conversation count badge\">\n                        12 recent\n                    </span>\n                </header>\n                <div aria-label=\"Conversation filters\" class=\"queue-filters\" data-kid=\"1-2-2-1-2\" data-name=\"queue filter group\" role=\"group\">\n                    <button class=\"filter selected\" data-kid=\"1-2-2-1-2-1\" data-name=\"needs-a-person filter button (selected)\" type=\"button\">\n                        Needs a person\n                        <span data-kid=\"1-2-2-1-2-1-1\" data-name=\"needs-a-person filter count\">\n                            8\n                        </span>\n                    </button>\n                    <button class=\"filter\" data-kid=\"1-2-2-1-2-2\" data-name=\"all conversations filter button\" type=\"button\">\n                        All 12\n                    </button>\n                </div>\n                <div class=\"queue-scroll\" data-kid=\"1-2-2-1-3\" data-name=\"scrollable queue list area\">\n                    <p class=\"queue-group\" data-kid=\"1-2-2-1-3-1\" data-name=\"waiting group label\">\n                        Waiting for a person\n                    </p>\n                    <div class=\"queue-list\" data-kid=\"1-2-2-1-3-2\" data-name=\"waiting conversations list\">\n                        <button aria-current=\"true\" class=\"queue-row active\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"active conversation row button\" type=\"button\">\n                            <span class=\"row-top\" data-kid=\"1-2-2-1-3-2-1-1\" data-name=\"row top line (person + status)\">\n                                <span class=\"person\" data-kid=\"1-2-2-1-3-2-1-1-1\" data-name=\"customer name text\">\n                                    Sam Okonkwo\n                                </span>\n                                <span class=\"status\" data-kid=\"1-2-2-1-3-2-1-1-2\" data-name=\"waiting status pill\">\n                                    <span class=\"status-dot\" data-kid=\"1-2-2-1-3-2-1-1-2-1\" data-name=\"status dot\">\n                                    </span>\n                                    Waiting\n                                </span>\n                            </span>\n                            <span class=\"row-meta\" data-kid=\"1-2-2-1-3-2-1-2\" data-name=\"row meta line (order msg count date)\">\n                                <span class=\"order\" data-kid=\"1-2-2-1-3-2-1-2-1\" data-name=\"order ID snippet\" title=\"ORD-6694cbe8-b616-41d2-90b3-b5208acefe4f\">\n                                    …90b3-b5208acefe4f\n                                </span>\n                                <span data-kid=\"1-2-2-1-3-2-1-2-2\" data-name=\"message count\">\n                                    2 msg\n                                </span>\n                                <span class=\"date\" data-kid=\"1-2-2-1-3-2-1-2-3\" data-name=\"timestamp tex