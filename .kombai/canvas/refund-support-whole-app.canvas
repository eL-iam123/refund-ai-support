      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Fira+Sans:wght@400;500;600;700&display=swap');\n@layer components {\n  .live-grid { display: grid; grid-template-columns: 272px minmax(0, 1fr) 296px; gap: 18px; align-items: stretch; }\n  .queue-scroll { max-height: 620px; overflow-y: auto; }\n  .case-scroll { max-height: 620px; overflow-y: auto; }\n  .mobile-back { display: none; }\n  @media (max-width: 1120px) {\n    .live-grid { grid-template-columns: minmax(0, 1fr); }\n    .queue-panel, .case-file { display: none; }\n    .mobile-back { display: inline-flex; }\n  }\n  @media (max-width: 700px) {\n    .shell-pad { padding-left: 16px !important; padding-right: 16px !important; }\n    .desktop-nav { display: none !important; }\n    .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }\n    .case-heading { align-items: flex-start !important; flex-direction: column !important; }\n    .conversation-messages { padding-left: 0 !important; padding-right: 0 !important; }\n  }\n}\n</style>\n<main class=\"min-h-screen min-w-[320px] bg-[#f7f5f2] font-['Fira_Sans',sans-serif] text-[#1c1917] antialiased\" data-kid=\"1\" data-name=\"main application layout\">\n    <header class=\"shell-pad flex min-h-[68px] items-center gap-8 border-b border-[#e7e2da] bg-[#fffdfa] px-8\" data-kid=\"1-1\" data-name=\"top application header bar\">\n        <a class=\"flex shrink-0 items-center gap-3 no-underline text-[#1c1917]\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"grid size-9 place-items-center rounded-[10px] bg-[#e85d04] text-sm font-bold text-white\" data-kid=\"1-1-1-1\" data-name=\"brand monogram badge\">\n                R\n            </span>\n            <span class=\"leading-tight\" data-kid=\"1-1-1-2\" data-name=\"brand text block\">\n                <strong class=\"block text-[15px] font-bold tracking-[-0.02em]\" data-kid=\"1-1-1-2-1\" data-name=\"brand name\">\n                    Refund Console\n                </strong>\n                <span class=\"mt-1 block text-[12px] text-[#78716c]\" data-kid=\"1-1-1-2-2\" data-name=\"brand subtitle\">\n                    operations\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Staff navigation\" class=\"desktop-nav ml-auto flex items-center gap-1\" data-kid=\"1-1-2\" data-name=\"staff navigation bar\">\n            <a class=\"rounded-md px-3 py-2 text-[14px] font-medium text-[#57534e] no-underline hover:bg-[#f3f1ed]\" data-kid=\"1-1-2-1\" data-name=\"nav link Overview\" href=\"#\">\n                Overview\n            </a>\n            <a aria-current=\"page\" class=\"rounded-md bg-[#fff0e5] px-3 py-2 text-[14px] font-semibold text-[#9b3e00] no-underline\" data-kid=\"1-1-2-2\" data-name=\"nav link Live (current page)\" href=\"#\">\n                Live\n            </a>\n            <a class=\"rounded-md px-3 py-2 text-[14px] font-medium text-[#57534e] no-underline hover:bg-[#f3f1ed]\" data-kid=\"1-1-2-3\" data-name=\"nav link Payouts\" href=\"#\">\n                Payouts\n            </a>\n            <a class=\"rounded-md px-3 py-2 text-[14px] font-medium text-[#57534e] no-underline hover:bg-[#f3f1ed]\" data-kid=\"1-1-2-4\" data-name=\"nav link Returns\" href=\"#\">\n                Returns\n            </a>\n            <a class=\"rounded-md px-3 py-2 text-[14px] font-medium text-[#57534e] no-underline hover:bg-[#f3f1ed]\" data-kid=\"1-1-2-5\" data-name=\"nav link All requests\" href=\"#\">\n                All requests\n            </a>\n            <a class=\"rounded-md px-3 py-2 text-[14px] font-medium text-[#57534e] no-underline hover:bg-[#f3f1ed]\" data-kid=\"1-1-2-6\" data-name=\"nav link Policy\" href=\"#\">\n                Policy\n            </a>\n            <span class=\"mx-2 h-6 w-px bg-[#e7e2da]\" data-kid=\"1-1-2-7\" data-name=\"nav vertical divider\">\n            </span>\n            <button class=\"min-h-10 rounded-md border border-[#d6cec3] bg-transparent px-3 text-[13px] font-semibold text-[#57534e]\" data-kid=\"1-1-2-8\" data-name=\"sign out button\" type=\"button\">\n                Sign out\n            </button>\n        </nav>\n        <button class=\"mobile-back min-h-10 items-center rounded-md border border-[#d6cec3] bg-[#fffdfa] px-3 text-sm font-semibold text-[#57534e]\" data-kid=\"1-1-3\" data-name=\"mobile back navigation button\" type=\"button\">\n            ← Back to conversations\n        </button>\n    </header>\n    <div class=\"shell-pad mx-auto max-w-[1440px] px-8 pb-8 pt-6\" data-kid=\"1-2\" data-name=\"page content container\">\n        <section class=\"mb-5 flex items-end justify-between gap-5\" data-kid=\"1-2-1\" data-name=\"page title header section\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 class=\"text-[26px] font-semibold leading-tight tracking-[-0.025em]\" data-kid=\"1-2-1-1-1\" data-name=\"page headline Live conversations\">\n                    Live conversations\n                </h1>\n                <p class=\"mt-1.5 max-w-[58ch] text-[15px] leading-6 text-[#57534e]\" data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Review a customer’s message, then take over when a person needs to reply.\n                </p>\n            </div>\n            <p class=\"pb-1 text-[13px] text-[#78716c]\" data-kid=\"1-2-1-2\" data-name=\"conversations count summary text\">\n                12 conversations in the last 24 hours\n            </p>\n        </section>\n        <section aria-label=\"Live queue summary\" class=\"summary-grid mb-5 grid grid-cols-[0.8fr_1fr_2.15fr_1fr] items-center gap-x-5 gap-y-3 rounded-xl border border-[#e7e2da] bg-[#fffdfa] px-5 py-3.5\" data-kid=\"1-2-2\" data-name=\"live queue summary stats bar\">\n            <div class=\"flex items-baseline gap-2 border-r border-[#e7e2da] pr-4\" data-kid=\"1-2-2-1\" data-name=\"waiting count stat group\">\n                <span class=\"text-[13px] text-[#57534e]\" data-kid=\"1-2-2-1-1\" data-name=\"waiting stat label\">\n                    Waiting\n                </span>\n                <strong class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-2-1-2\" data-name=\"waiting stat value\">\n                    8\n                </strong>\n            </div>\n            <div class=\"flex items-baseline gap-2 border-r border-[#e7e2da] pr-4\" data-kid=\"1-2-2-2\" data-name=\"needs review stat group\">\n                <span class=\"text-[13px] text-[#57534e]\" data-kid=\"1-2-2-2-1\" data-name=\"needs review stat label\">\n                    Needs review\n                </span>\n                <strong class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-2-2-2\" data-name=\"needs review stat value\">\n                    $0.00\n                </strong>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-x-2.5 gap-y-1.5 border-r border-[#e7e2da] pr-4\" data-kid=\"1-2-2-3\" data-name=\"today decisions stat group\">\n                <span class=\"mr-1 text-[13px] text-[#57534e]\" data-kid=\"1-2-2-3-1\" data-name=\"today decisions stat label\">\n                    Decided today\n                </span>\n                <span class=\"rounded-full border border-[#abefc6] bg-[#eaf8f0] px-2 py-1 text-[12px] font-semibold text-[#087443]\" data-kid=\"1-2-2-3-2\" data-name=\"approved decisions badge\">\n                    1 approved\n                </span>\n                <span class=\"rounded-full border border-[#fecdca] bg-[#fff0ef] px-2 py-1 text-[12px] font-semibold text-[#b42318]\" data-kid=\"1-2-2-3-3\" data-name=\"denied decisions badge\">\n                    4 denied\n                </span>\n                <span class=\"rounded-full border border-[#f1d080] bg-[#fff7df] px-2 py-1 text-[12px] font-semibold text-[#805600]\" data-kid=\"1-2-2-3-4\" data-name=\"escalated decisions badge\">\n                    6 escalated\n                </span>\n            </div>\n            <div class=\"flex items-baseline gap-2\" data-kid=\"1-2-2-4\" data-name=\"average takeover stat group\">\n                <span class=\"text-[13px] text-[#57534e]\" data-kid=\"1-2-2-4-1\" data-name=\"average takeover stat label\">\n                    Avg. takeover\n                </span>\n                <strong class=\"text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-2-4-2\" data-name=\"average takeover stat value\">\n                    0 min\n                </strong>\n            </div>\n            <p class=\"col-span-full text-[12px] text-[#78716c]\" data-kid=\"1-2-2-5\" data-name=\"decisions footnote text\">\n                11 decisions today · counted from 7 Oct, 01:00\n            </p>\n        </section>\n        <div class=\"live-grid\" data-kid=\"1-2-3\" data-name=\"three-column live layout grid\">\n            <aside aria-label=\"Conversation queue\" class=\"queue-panel min-w-0 overflow-hidden rounded-xl border border-[#e7e2da] bg-[#fffdfa]\" data-kid=\"1-2-3-1\" data-name=\"conversation queue panel\">\n                <div class=\"flex min-h-[56px] items-center justify-between border-b border-[#e7e2da] px-4\" data-kid=\"1-2-3-1-1\" data-name=\"queue panel header\">\n                    <h2 class=\"text-[16px] font-semibold\" data-kid=\"1-2-3-1-1-1\" data-name=\"queue panel title\">\n                        Conversations\n                    </h2>\n                    <span class=\"text-[13px] text-[#78716c]\" data-kid=\"1-2-3-1-1-2\" data-name=\"queue panel recent conversation count\">\n                        12 recent\n                    </span>\n                </div>\n                <div class=\"queue-scroll px-3 pb-3\" data-kid=\"1-2-3-1-2\" data-name=\"queue scroll container\">\n                    <section class=\"pt-3\" data-kid=\"1-2-3-1-2-1\" data-name=\"waiting conversations section\">\n                        <div class=\"mb-1.5 flex items-center justify-between px-1\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"waiting section header\">\n                            <h3 class=\"text-[13px] font-semibold text-[#57534e]\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"waiting section title\">\n                                Waiting for a person\n                            </h3>\n                            <span class=\"text-[12px] tabular-nums text-[#78716c]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"waiting section count\">\n                                4\n                            </span>\n                        </div>\n                        <ul class=\"m-0 list-none p-0\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"waiting conversations list\">\n                            <li data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"waiting conversation list item\">\n                                <button aria-current=\"true\" class=\"w-full rounded-lg bg-[#fff0e5] px-3 py-2.5 text-left text-[#1c1917] outline outline-1 outline-[#f3c19e]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"active conversation card button\" type=\"button\">\n                                    <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-3-1-2-1-2-1-1-1\" data-name=\"conversation card name row\">\n                                        <strong class=\"truncate text-[14px] font-semibold\" data-kid=\"1-2-3-1-2-1-2-1-1-1-1\" data-name=\"conversation customer name\">\n                                            Sam Okonkwo\n                                        </strong>\n                                        <span class=\"shrink-0 rounded-full bg-[#fff7df] px-2 py-0.5 text-[11px] font-semibold text-[#805600]\" data-kid=\"1-2-3-1-2-1-2-1-1-1-2\" data-name=\"conversation status badge\">\n                                            Waiting\n                                        </span>\n                                    </span>\n                                    <span class=\"mt-1.5 flex items-center justify-between gap-2 text-[12px] te