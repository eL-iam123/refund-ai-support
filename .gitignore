node_modules/
dist/
coverage/

# Secrets. The API reads these from the environment; a committed key is a
# published key, and history keeps it after a later deletion.
.env
.env.*
!.env.example

# Local state. The container's database lives on a volume; this is the
# development copy, and it is not a source artefact.
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

# Local agent worktrees. `.kilo/worktrees/` holds a full nested checkout of this
# repository, and because it carries its own `.git` it is not excluded by any of
# the rules above. Untracked is not the same as ignored: `git add -A` would stage
# a second copy of the entire source tree, and lint would typecheck both copies.
.kilo/
