# Setup instructions live in README.md → "Configuration".
# This file holds values, not explanations. Everything it does not set uses a
# default from apps/api/src/config/env.ts.

# --- Required ---------------------------------------------------------------

# Staff API signing key. Generate with: openssl rand -hex 32
# Anyone holding this can mint admin tokens, so never commit it.
ADMIN_API_SECRET=replace-me-with-openssl-rand-hex-32

# Model provider. See README.md → "Choosing a model".
#   groq | nvidia | openrouter | gemini | anthropic | openai | local
# `local` is a pattern matcher with no key. Refused in production.
AI_PROVIDER=groq

# The key for AI_PROVIDER, uncommented to match it. Free tiers: groq, nvidia,
# openrouter, gemini. `openai` needs a paid key.
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Usually unchanged ------------------------------------------------------

NODE_ENV=development
API_PORT=4000
DATABASE_PATH=./data/refund.sqlite
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Set these only if you know you need to ---------------------------------
# README.md explains what each one changes and what it costs.

# Refuse to start without a usable model instead of escalating everything.
# Unset means: required in production, tolerated in development. Set true to
# demand a key even in development, false to boot and escalate regardless.
# AI_REQUIRED=true

# AI_MODEL=llama-3.3-70b-versatile
# AI_FALLBACK_MODELS=
# AI_TOTAL_BUDGET_MS=45000
# AI_MAX_TOKENS=700
# AI_SHARE_ORDER_FACTS=false
# INJECTION_ACTION=deny
# MAX_MESSAGE_LENGTH=4000
# DUPLICATE_WINDOW_HOURS=72
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=1 minute
# LOG_LEVEL=info
