# Setup instructions live in README.md → "Configuration".
# This file holds values, not explanations. Everything it does not set uses a
# default from apps/api/src/config/env.ts.
#
# Copy this to .env. Nothing here is required to start: the shop, the assistant
# and the refund policy all work with an empty .env, and the AI degrades to
# escalating every claim to a person rather than guessing at one.

# --- The admin console ------------------------------------------------------
#
# The staff console does not exist until both of these are set. With neither, the
# /admin page is not rendered and every staff route answers 404, so an
# unconfigured deployment has no admin surface to find. The demo pair is in
# admin-login.txt. The API refuses this exact password in production.
#
#   openssl rand -base64 24
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=refund-desk-demo

# Optional. The key staff sessions are signed with. It is derived from
# ADMIN_PASSWORD when unset, so it is not needed for the console to work - set it
# only to have one value that invalidates every session at once when rotated.
#   openssl rand -hex 32
# ADMIN_API_SECRET=

# --- The model ---------------------------------------------------------------
#
# Paste your key here and start the stack. That is the whole setup.
#
#   openai     sk-...         paid
#   anthropic  sk-ant-...     paid
#   gemini     AIza...        free tier
#   nvidia     nvapi-...      free tier
#   openrouter sk-or-v1-...   free tier
#   groq       gsk_...        free tier
#
# The provider is worked out from the key, so you do not have to set anything
# else. To use a provider's own endpoint instead, set AI_PROVIDER below.
AI_API_KEY=

# Optional. Overrides the provider inferred from the key, and is required for a
# key whose shape is not one of the prefixes above - which is what a self-hosted
# or OpenAI-compatible endpoint is. `local` runs a pattern matcher with no model
# at all, and is refused in production.
#   openai | anthropic | gemini | nvidia | openrouter | groq | local
# AI_PROVIDER=openai

# Optional. Per-provider keys still work, for a setup that keeps them separate.
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Usually unchanged ------------------------------------------------------

NODE_ENV=development
API_PORT=4000
DATABASE_PATH=./data/refund.sqlite
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- Set these only if you know you need to ---------------------------------
# README.md explains what each one changes and what it costs.

# Refuse to start without a usable model instead of escalating everything.
# Unset means: required in production, tolerated in development. Set true to
# demand a key even in development, false to boot and escalate regardless.
# AI_REQUIRED=true

# AI_MODEL=llama-3.3-70b-versatile
# AI_FALLBACK_MODELS=
# AI_TOTAL_BUDGET_MS=45000
# AI_MAX_TOKENS=700
# AI_SHARE_ORDER_FACTS=false
# INJECTION_ACTION=deny
# MAX_MESSAGE_LENGTH=4000
# DUPLICATE_WINDOW_HOURS=72
# RATE_LIMIT_MAX=300 # development default; production defaults to 30 when unset
# RATE_LIMIT_WINDOW=1 minute
# LOG_LEVEL=info
