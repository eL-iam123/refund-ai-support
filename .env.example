# ---------------------------------------------------------------------------
# Copy to .env and fill in what you need.
#
#   cp .env.example .env
#
# A model is required. There is no offline mode: pick a provider below and
# supply its key, or the server refuses to start with a message naming the
# variable it is missing. Keys are free at Groq and OpenRouter.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Where the SQLite file lives. The compose stack mounts ./data here.
DATABASE_PATH=./data/refund.sqlite

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- AI provider -----------------------------------------------------------
# groq        Groq (https://console.groq.com/keys)     - free tier, fastest
# nvidia      NVIDIA NIM (https://build.nvidia.com)     - free dev tier, named models
# openrouter  OpenRouter (https://openrouter.ai/keys) - free tier, most models
# openai      api.openai.com                         - requires a paid key
AI_PROVIDER=groq

# Model id. Optional: each provider has a sensible default, so leaving this
# commented out is the recommended starting point.
# AI_MODEL=llama-3.3-70b-versatile
#
# Name a SPECIFIC model, not a router. OpenRouter's `openrouter/free` was
# measured returning an empty body, and a 2775-character chain of thought
# truncated mid-JSON, because it routes to whatever free model is healthy and
# many of them ignore `response_format: json_object`. The adapter fails over
# safely, so this costs a wasted round trip and latency rather than correctness,
# but there is no reason to pay it.

# Extra models tried in order when the primary returns 429/5xx/timeout. Free
# tiers are rate-limited, so failing over across models works far better than
# retrying the same model - the same model usually stays rate-limited. Model ids
# are provider-specific, so these must match the provider you selected.
AI_FALLBACK_MODELS=

# Required: the key for whichever provider you selected. The server names the
# missing variable on startup rather than failing on the first customer.
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Which models were measured against this pipeline, and what they cost in time.
# Verify a model before trusting the catalogue: NVIDIA's `GET /v1/models`
# advertises ids an account cannot invoke (llama-3.1-nemotron-70b-instruct and
# nemotron-4-340b-instruct both answered 404 "not found for account"), and of the
# ids that did run, most ignored `response_format` and spent the token budget on
# prose. Only these produced schema-valid, grounded JSON:
#
#   nvidia/nemotron-3-ultra-550b-a55b  3/3 valid, ~11s average, ~13s worst
#   llama-3.3-70b-versatile (groq)     fast
#   gpt-4o-mini (openai)               fast
#
# Plan for the latency: a real generation here is seconds, not milliseconds.
# AI_TOTAL_BUDGET_MS is the number a customer actually waits, so keep it above
# the worst observed call.

# Override the provider base URL (rarely needed - presets cover it).
# AI_BASE_URL=

# Per-request allowance. The real limit on how long a customer waits is
# AI_TOTAL_BUDGET_MS below, which covers every model, every retry and the repair
# pass together.
AI_TIMEOUT_MS=30000
AI_TOTAL_BUDGET_MS=45000
AI_MAX_ATTEMPTS=2

# 700 is about 5x a schema-valid extraction. A larger value is not "safer": a
# model that ignores JSON mode spends the whole budget on prose and returns
# nothing parseable, and the adapter then fails over to the next candidate.
AI_MAX_TOKENS=700

# --- Policy ----------------------------------------------------------------
# There is no model-written customer reply. Replies are always composed from the
# decision by `response/compose.ts`, so nothing the customer reads can come from
# a model or from their own message.
#
# Sends order facts to the model alongside the customer's message. It improves
# extraction of "the whole order" phrasing; it is also the only customer data
# that leaves the server, so set true only if that trade is worth it.
AI_SHARE_ORDER_FACTS=false

# What a detected policy-override attempt does. R-14 in REFUND_POLICY.md §7.1
# specifies `deny`. Set `escalate` if your business would rather send these to a
# human than refuse the customer.
INJECTION_ACTION=deny

# --- Limits ----------------------------------------------------------------
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute

# Staff API tokens. Required: the server refuses to start without it.
# Generate your own with: openssl rand -hex 32
# Never commit a real value. Anyone holding this can mint agent and admin
# tokens, which is the same as being able to override refund decisions.
ADMIN_API_SECRET=replace-me-with-openssl-rand-hex-32
